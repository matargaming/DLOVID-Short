<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DLOVID"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHORT DRAMA GOLD"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.3"
            android:layout_marginBottom="40dp"/>

        <EditText android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email / No HP"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edit_gold"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <EditText android:id="@+id/etSandi"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Sandi"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edit_gold"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <EditText android:id="@+id/etConfirmSandi"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirm Sandi"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edit_gold"
            android:padding="15dp"
            android:layout_marginBottom="10dp"/>

        <CheckBox android:id="@+id/cbShowPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intip sandi 👁️"
            android:textColor="#FFD700"
            android:buttonTint="#FFD700"
            android:layout_marginBottom="25dp"/>

        <Button android:id="@+id/btnKirimOtp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="KIRIM OTP VIA HP/EMAIL"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_button"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnLoginPengguna"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGIN PENGGUNA"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/bg_card_film"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnLoginAdmin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGIN ADMIN"
            android:textColor="#FFD700"
            android:background="@drawable/bg_card_film"
            android:layout_marginBottom="20dp"/>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF88"
            android:textSize="13sp"
            android:layout_marginBottom="10dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PANEL ADMIN - Masukkan 2 sandi lagi:"
            android:textColor="#FFD700" android:textSize="12sp" android:layout_marginBottom="10dp"/>

        <EditText android:id="@+id/etAdminKey2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Sandi ADMIN_KEY_2"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/bg_edit_gold"
            android:padding="15dp"
            android:layout_marginBottom="12dp"/>

        <EditText android:id="@+id/etAdminKey3"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Sandi ADMIN_KEY_3"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@drawable/bg_edit_gold"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <Button android:id="@+id/btnMasukAdmin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="MASUK PANEL ADMIN"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/bg_gold_button"/>

    </LinearLayout>
</ScrollView>
